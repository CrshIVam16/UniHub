# Server environment example
# Copy this to server/.env and fill in your own values.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/unihub?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
